    "plist": "^5.0.0",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-reconciler": "0.33.0",
    "shell-quote": "^1.10.0",
    "signal-exit": "^4.1.0",
    "sqlite-vec": "^0.1.9",
    "supports-hyperlinks": "^4.5.0",
    "tree-kill": "^1.2.2",
    "turndown": "^7.2.4",
    "undici": "^8.10.0",
    "usehooks-ts": "^3.1.1",
    "vscode-jsonrpc": "^9.0.1",
    "xss": "^1.0.15",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.4",
    "@hono/node-server": "2.1.0",
    "@protobufjs/utf8": "1.1.2",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.9",
    "fast-uri": "4.1.2",
