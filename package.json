{
  "name": "clew-code",
  "version": "0.10.1",
  "description": "ClewCode â€” multi-provider AI coding agent CLI",
  "main": "./dist/main.js",
  "type": "module",
  "bin": {
    "clew": "bin/clew.cjs",
    "clewcode": "bin/clew.cjs"
  },
  "files": [
    "bin/",
    "dist/",
    "docs/",
    "scripts/",
    "README.md",
    "LICENSE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClewCode/ClewCode.git"
  },
  "bugs": {
    "url": "https://github.com/ClewCode/ClewCode/issues"
  },
  "homepage": "https://github.com/ClewCode/ClewCode#readme",
  "scripts": {
    "prebuild-version": "node scripts/prebuild-version.mjs",
    "dev": "bun run prebuild-version && node scripts/bun-run.mjs --watch",
    "start": "bun run prebuild-version && node scripts/bun-run.mjs",
    "dev:channels": "bun run prebuild-version && node scripts/bun-run.mjs -- --dangerously-load-development-channels server:clew-orc",
    "build": "bun run prebuild-version && node scripts/build.mjs && node scripts/postbuild-inject-macro.mjs",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "lint": "biome lint --write src/",
    "lint:check": "biome lint src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "cleanup:memory-db": "node scripts/cleanup-memory-db.mjs --force",
    "cleanup:memory-db:dry": "node scripts/cleanup-memory-db.mjs --dry-run",
    "check": "biome check --write src/",
    "check:ci": "biome ci src/ && bun run check:circular && bun run check:suppressions",
    "check:circular": "node scripts/check-circular-deps.mjs",
    "check:circular:strict": "node scripts/check-circular-deps.mjs --strict",
    "check:suppressions": "node scripts/check-type-suppressions.mjs",
    "check:suppressions:strict": "node scripts/check-type-suppressions.mjs --strict",
    "ast-grep": "bun x ast-grep",
    "docs:generate": "bun run scripts/generate-docs.ts",
    "docs:watch": "bun --watch run scripts/generate-docs.ts",
    "preload": "bun run scripts/preload.ts",
    "session": "bun run scripts/session.ts",
    "agent-room": "bun run scripts/agent-room.ts",
    "install:unix": "bash scripts/install.sh",
    "install:win": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
    "test:pr-changelog": "node --test scripts/pr-changelog.test.mjs"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "anthropic",
    "openai",
    "google",
    "gemini",
    "claude",
    "gpt",
    "openrouter",
    "kilocode",
    "opencode"
  ],
  "author": "Dek1milliontoken",
  "license": "SEE LICENSE.md",
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.59",
